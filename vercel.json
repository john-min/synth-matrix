{
  "version": 2,
  "builds": [
    {
      "src": "api/messages.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/messages",
      "dest": "/api/messages.js"
    },
    {
      "src": "/(.*\\.(jpg|jpeg|png|gif|svg|css|js))",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
